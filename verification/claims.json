{
  "$comment": "Machine-checkable security claims for CARD v2. Run `npm run verify`; do not ship if any claim is red.",
  "contract": "CardinalsPromise",
  "artifact": "artifacts/contracts/CardinalsPromise.sol/CardinalsPromise.json",
  "claims": [
    {
      "id": "fixed-supply",
      "statement": "Total supply is exactly 1,000,000,000 CARD, minted once at deployment to the treasury.",
      "source": "CardinalsPromise.sol",
      "evidence": [
        {
          "type": "solidity-test",
          "file": "contracts/CardinalsPromise.t.sol",
          "name": "test_FullSupplyMintedToTreasury"
        },
        {
          "type": "node-test",
          "file": "test/CardinalsPromise.ts",
          "title": "mints the full fixed supply to the treasury"
        },
        {
          "type": "invariant",
          "file": "contracts/CardinalsPromiseInvariants.t.sol",
          "name": "invariant_TotalSupplyConstant"
        }
      ]
    },
    {
      "id": "no-public-mint-burn-rebase",
      "statement": "There is no public mint, burn, issue, or rebase function; supply remains constant after construction.",
      "source": "CardinalsPromise.sol",
      "evidence": [
        {
          "type": "abi-absent",
          "patterns": ["mint", "burn", "issue", "rebase"]
        },
        {
          "type": "invariant",
          "file": "contracts/CardinalsPromiseInvariants.t.sol",
          "name": "invariant_TotalSupplyConstant"
        },
        {
          "type": "invariant",
          "file": "contracts/CardinalsPromiseInvariants.t.sol",
          "name": "invariant_BalancesSumToTotalSupply"
        }
      ]
    },
    {
      "id": "member-to-member-blocked",
      "statement": "An approved member cannot transfer CARD to another member or arbitrary wallet.",
      "source": "CardinalsPromise.sol _update",
      "evidence": [
        {
          "type": "solidity-test",
          "file": "contracts/CardinalsPromise.t.sol",
          "name": "test_RevertWhen_MemberTransfersToMember"
        },
        {
          "type": "solidity-test",
          "file": "contracts/CardinalsPromise.t.sol",
          "name": "test_RevertWhen_MemberTransfersToArbitraryAddress"
        },
        {
          "type": "node-test",
          "file": "test/CardinalsPromise.ts",
          "title": "rejects member-to-member transfers"
        },
        {
          "type": "node-test",
          "file": "test/CardinalsPromise.ts",
          "title": "rejects transfers to arbitrary addresses"
        }
      ]
    },
    {
      "id": "approved-spend-path",
      "statement": "An approved member can spend CARD at an approved merchant, and approved participants can return CARD to the treasury.",
      "source": "CardinalsPromise.sol _update",
      "evidence": [
        {
          "type": "solidity-test",
          "file": "contracts/CardinalsPromise.t.sol",
          "name": "test_MemberCanSpendAtMerchant"
        },
        {
          "type": "node-test",
          "file": "test/CardinalsPromise.ts",
          "title": "allows an approved member to spend at an approved merchant"
        }
      ]
    },
    {
      "id": "transferfrom-cannot-bypass",
      "statement": "ERC-20 allowances cannot bypass CARD's permitted destination rules.",
      "source": "CardinalsPromise.sol _update",
      "evidence": [
        {
          "type": "solidity-test",
          "file": "contracts/CardinalsPromise.t.sol",
          "name": "test_TransferFromCannotBypassRestrictions"
        },
        {
          "type": "node-test",
          "file": "test/CardinalsPromise.ts",
          "title": "transferFrom cannot bypass the destination rules"
        }
      ]
    },
    {
      "id": "emergency-pause",
      "statement": "The administrator can pause pilot token movement in an emergency.",
      "source": "CardinalsPromise.sol pause/unpause",
      "evidence": [
        {
          "type": "solidity-test",
          "file": "contracts/CardinalsPromise.t.sol",
          "name": "test_PauseStopsTransfers"
        },
        {
          "type": "node-test",
          "file": "test/CardinalsPromise.ts",
          "title": "pause stops pilot transfers"
        }
      ]
    },
    {
      "id": "renounce-disabled",
      "statement": "The operational admin role cannot be accidentally destroyed by renouncing ownership.",
      "source": "CardinalsPromise.sol renounceOwnership",
      "evidence": [
        {
          "type": "solidity-test",
          "file": "contracts/CardinalsPromise.t.sol",
          "name": "test_RenounceOwnershipDisabled"
        }
      ]
    },
    {
      "id": "reviewed-write-surface",
      "statement": "The state-changing public surface is limited to standard ERC-20 approvals/transfers, participant administration, pause controls, and ownership transfer.",
      "source": "CardinalsPromise.sol ABI",
      "evidence": [
        {
          "type": "abi-write-surface",
          "allowed": [
            "approve",
            "pause",
            "setMember",
            "setMerchant",
            "transfer",
            "transferFrom",
            "transferOwnership",
