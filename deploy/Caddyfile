# Cardinal Books — Caddy reverse proxy (HTTPS + password gate).
#
# EDIT THREE THINGS below, then `docker compose -f deploy/books-stack.yml up -d`:
#   1. Replace  books.example.com  with your real domain (its A record must
#      already point at this server's IP).
#   2. Replace  admin  with the username you want.
#   3. Replace the hash after the username with your own. Generate it with:
#        docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
#      Paste the whole "$2a$..." string it prints (keep the single quotes off).
#
# Caddy fetches and renews a free Let's Encrypt certificate automatically.

books.example.com {
	basic_auth {
		admin $2a$14$REPLACE_WITH_YOUR_GENERATED_HASH
	}
	reverse_proxy books:4500
}
