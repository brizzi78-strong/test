[Unit]
Description=Cardinal dating app
After=network.target

[Service]
Type=simple
User=cardinal
Group=cardinal
WorkingDirectory=__APP_DIR__
Environment=PORT=3000
Environment=CARDINAL_DB=__DATA_DIR__/cardinal.db
ExecStart=/usr/bin/node __APP_DIR__/server.mjs
Restart=always
RestartSec=3

# Hardening — the service can only touch its own data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__DATA_DIR__

[Install]
WantedBy=multi-user.target
